# Copy to backend/.env and fill in.
GEMINI_API_KEY=your-key-here

# Model IDs copied from the original app. Change them here if Google renames/retires one.
# GEMINI_MODEL_TEXT=gemini-3.8-flash
# GEMINI_MODEL_IMAGE=gemini-3.1-flash-lite-image

# Persona portraits generated in parallel (lower this if you hit rate limits)
# IMAGE_CONCURRENCY=3

# Requests per minute per client IP; 0 disables
# RATE_LIMIT_PER_MINUTE=30

# Only if the UI is served from a different origin than the API (JSON list)
# CORS_ORIGINS=["http://localhost:3000"]